# RViz layout for the mission stacks (mission_2*.launch.py, use_rviz:=true).
#
# THE `Panels` AND `Window Geometry` SECTIONS ARE COPIED FROM A WORKING STOCK
# CONFIG ON PURPOSE -- DO NOT HAND-TRIM THEM.
#
# RViz on this install SEGFAULTS while building its dock layout if a config
# declares any panel beyond Displays/Views without the serialized
# `QMainWindow State` blob below. Bisected: the previous 2-panel config ran
# fine, and adding ANY third panel on its own -- Tool Properties, Selection or
# Time, each tried separately -- crashed rviz2 with SIGSEGV before its window
# ever appeared. Stock `rviz2` with no -d works because ~/.rviz2/default.rviz
# ships that blob. So the panel list and geometry here are taken verbatim from
# it, and only the `Visualization Manager` section below is ours.
#
# (Also absent for the same class of reason: an rviz_visual_tools panel. That
# plugin is not installed here -- rviz reports the class does not exist -- and
# referencing it likewise takes the process down rather than warning.)
Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Robot1
    - /Navigation1
    - /Perception1
    Splitter Ratio: 0.5
  Tree Height: 640
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded:
  - /2D Goal Pose1
  - /Publish Point1
  Name: Tool Properties
  Splitter Ratio: 0.5886790156364441
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
- Class: rviz_common/Time
  Experimental: false
  Name: Time
  SyncMode: 0
  SyncSource: ''
Visualization Manager:
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Cell Size: 1
    Plane Cell Count: 40
    Color: 100; 100; 100
    # Z = -0.13228 puts the grid on the FLOOR rather than at odom's origin.
    # The EKF runs two_d_mode:=true, which forces z=0 on the odom->base_link
    # transform it publishes, so base_link sits at odom z=0 even though it is
    # physically 0.13228 m up (that is base_footprint_joint's offset, and
    # wheel_radius - wheel_vertical_offset). The floor therefore lies at
    # z=-0.13228 in odom/map, and a grid drawn at 0 slices each wheel 33 mm
    # above its centre -- the robot looks sunk to its axles.
    #
    # Fixed HERE and not in the EKF on purpose. two_d_mode:=false would let z
    # go, and nothing in this filter measures z, vz, roll or pitch (odom0
    # supplies vx only, imu0 yaw only), so they would random-walk and take the
    # heading fusion with them. Re-rooting the URDF at base_footprint -- the
    # textbook fix -- is worse still: the URDF root IS MoveIt's planning frame,
    # so every mission z (GROUND_Z, grasp/carry heights) would shift 0.13228.
    # Nothing functional reads this z anyway: AMCL, the costmaps and Nav2 are
    # 2D, and MoveIt plans base_link-relative.
    Offset:
      X: 0
      Y: 0
      Z: -0.13228
    Value: true
  - Class: rviz_common/Group
    Name: Robot
    Value: true
    Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Marker Scale: 0.4
      Show Axes: true
      Show Names: false
      Show Arrows: false
      Frames:
        All Enabled: false
        base_link:
          Value: true
        base_footprint:
          Value: true
        odom:
          Value: true
        map:
          Value: true
        lidar_link:
          Value: true
        front_camera_link:
          Value: true
        camera_link:
          Value: true
        fr3_hand_tcp:
          Value: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (EKF)
      Topic:
        Value: /odometry/filtered
        Reliability Policy: Reliable
      Keep: 60
      Shape:
        Value: Arrow
        Alpha: 0.6
        Color: 255; 170; 0
        Shaft Length: 0.15
        Shaft Radius: 0.03
        Head Length: 0.08
        Head Radius: 0.06
      Covariance:
        Value: false
      Value: true
  - Class: rviz_common/Group
    Name: Navigation
    Value: true
    Displays:
    - Class: rviz_default_plugins/Map
      Name: Map (static)
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Color Scheme: map
      Draw Behind: true
      Alpha: 0.7
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
      Color Scheme: costmap
      Draw Behind: true
      Alpha: 0.4
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
      Color Scheme: costmap
      Draw Behind: true
      Alpha: 0.6
      Value: true
    - Class: rviz_default_plugins/Polygon
      Name: Robot Footprint
      Topic:
        Value: /local_costmap/published_footprint
      Color: 0; 200; 255
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Topic:
        Value: /plan
      Color: 0; 255; 0
      Line Width: 0.04
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Topic:
        Value: /local_plan
      Color: 255; 0; 255
      Line Width: 0.03
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Name: AMCL Particles
      Topic:
        Value: /particle_cloud
        Durability Policy: Volatile
      Shape: Arrow (Flat)
      Arrow Length: 0.2
      Color: 0; 180; 255
      Alpha: 0.5
      Value: true
  - Class: rviz_common/Group
    Name: Perception
    Value: true
    Displays:
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.04
      Style: Points
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Front Cloud
      Topic:
        Value: /front_camera/points
        Reliability Policy: Best Effort
      Size (m): 0.01
      Style: Points
      Color Transformer: RGB8
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Wrist Cloud
      Topic:
        Value: /camera/points
        Reliability Policy: Best Effort
      Size (m): 0.01
      Style: Points
      Color Transformer: RGB8
      Decay Time: 0
      Value: false
    - Class: rviz_default_plugins/Image
      Name: Front Camera
      Topic:
        Value: /front_camera/image
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Wrist Camera
      Topic:
        Value: /camera/image
        Reliability Policy: Best Effort
      Value: true
  - Class: moveit_rviz_plugin/MotionPlanning
    Name: MotionPlanning
    Move Group Namespace: ''
    Robot Description: robot_description
    Planning Scene Topic: monitored_planning_scene
    Planning Request:
      Planning Group: arm
      Query Start State: false
      Query Goal State: false
    Planned Path:
      Loop Animation: true
      State Display Time: 0.05 s
      Trajectory Topic: display_planned_path
      Show Robot Visual: true
      Show Trail: false
    Scene Geometry:
      Scene Alpha: 0.9
      Show Scene Geometry: true
    Scene Robot:
      Robot Alpha: 0.5
      Show Robot Visual: false
    Value: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 20
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Orbit (map)
      Distance: 12.0
      Focal Point:
        X: 0.5
        Y: 0.0
        Z: 0.0
      Pitch: 0.9
      Yaw: 0.6
      Target Frame: map
    Saved:
    - Class: rviz_default_plugins/Orbit
      Name: Chase robot
      Distance: 4.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pitch: 0.7
      Yaw: 3.1
      Target Frame: base_link
    - Class: rviz_default_plugins/Orbit
      Name: Gripper close-up
      Distance: 1.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pitch: 0.4
      Yaw: 2.4
      Target Frame: fr3_hand_tcp
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1720
  X: 283
  Y: 144
  Front Camera:
    collapsed: false
  Wrist Camera:
    collapsed: false
