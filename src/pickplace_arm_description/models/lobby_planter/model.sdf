<?xml version="1.0" ?>
<!-- Large lobby planter: a broad-leafed plant in a round ceramic bowl.

     Built from primitives, because Fuel has no indoor plant at this scale -
     everything there is either a scanned desk ornament 10-20 cm across or an
     outdoor tree. Primitives also cost the renderer almost nothing, which
     matters in a world already running at about half real time.

     The shape follows a real potted plant rather than the ball-on-a-stick this
     replaces: a bowl profiled from stacked cylinders of growing radius with a
     saucer under it, bark chips on the soil, several stems splaying out of the
     centre, and broad leaves drooping off their tips in two tiers.

     WHAT IT STILL IS NOT: a monstera. Those deep-split leaves need a real
     polygon outline, which only a mesh can carry - a primitive leaf is a flat
     plate. Swapping in a .dae later is a one-line change to the visual below.

     Sized to replace the previous planter exactly - 0.72 m across the bowl,
     about 1.75 m tall - so its pose in the world does not move.

     Collision is deliberately two primitives, not one per leaf: the LIDAR and
     Nav2 only need to know something solid stands here. -->
<sdf version="1.9">
  <model name="lobby_planter">
    <static>true</static>
    <link name="link">

      <collision name="pot_collision">
        <pose>0 0 0.24 0 0 0</pose>
        <geometry><cylinder><radius>0.36</radius><length>0.48</length></cylinder></geometry>
      </collision>
      <collision name="crown_collision">
        <pose>0 0 1.15 0 0 0</pose>
        <geometry><cylinder><radius>0.45</radius><length>0.70</length></cylinder></geometry>
      </collision>

      <visual name="saucer">
        <pose>0.000 0.000 0.015 0.000 0.000 0.000</pose>
        <geometry><cylinder><radius>0.4</radius><length>0.030</length></cylinder></geometry>
        <material><ambient>0.3 0.16 0.1 1</ambient><diffuse>0.38 0.21 0.13 1</diffuse></material>
      </visual>
      <visual name="bowl_0">
        <pose>0.000 0.000 0.075 0.000 0.000 0.000</pose>
        <geometry><cylinder><radius>0.2</radius><length>0.090</length></cylinder></geometry>
        <material><ambient>0.1 0.2 0.14 1</ambient><diffuse>0.16 0.3 0.2 1</diffuse></material>
      </visual>
