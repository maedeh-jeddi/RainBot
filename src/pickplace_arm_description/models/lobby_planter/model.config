<?xml version="1.0"?>
<!-- Required for model://lobby_planter to resolve. A model directory without
     this file is skipped silently by gz - the include simply never appears -
     which is exactly how the pedestrian model came to be invisible earlier. -->
<model>
  <name>lobby_planter</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>Large planter, 1.75 m tall, for the middle of the hospital lobby.</description>
</model>
