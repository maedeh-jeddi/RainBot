<?xml version="1.0"?>
<!-- Required for model://lab_bench resolution. The other models in this
     directory have no model.config because they are spawned by file path
     (`ros_gz_sim create -file .../model.sdf`) from the mission launch; this one
     is referenced by URI from hospital_lab.sdf, and gz only recognises a
     directory as a model when it carries this file. -->
<model>
  <name>lab_bench</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Lab counter with a low transfer shelf (top at z = 0.30) used as the sample
    collection point in the lab and the delivery point in the ward.
  </description>
</model>
