<?xml version="1.0" ?>
<!-- Blood sample rack: six capped tubes in a carrier with an overhead grip
     block. This is the payload of the lab -> ward transport mission.

     Two deliberate choices, both so the existing pick pipeline transfers over
     without being rewritten:

     * The grip block is a 0.06 m cube, the same size as the coloured boxes the
       colour-sorting mission grasps, so the Franka Hand closes to the same
       finger gap and grab_below's grasp verification threshold still holds. It
       is also cube-shaped rather than a flat tab so the grasp works from any
       approach yaw.
     * The block is saturated red, so the front camera's existing HSV red
       detector finds the rack with no new perception code.

     The model origin is the BOTTOM of the tray, not its centre, so it spawns
     at exactly the height of whatever it stands on (lab_bench's transfer shelf
     top is z = 0.30, so the rack spawns at z = 0.30).

     Height budget, from the tray's underside:
       0.000 - 0.025  tray floor
       0.025 - 0.095  tubes
       0.095 - 0.107  tube caps
       0.025 - 0.125  gantry posts (clear of the caps)
       0.125 - 0.140  gantry crossbar
       0.140 - 0.200  grip block   (centre 0.170)

     Collision is deliberately coarser than the visuals: the tray, the gantry
     and the grip block have collision geometry, the tubes do not. The tubes sit
     inside the rack and can never be the first thing to touch anything, so
     giving them contact geometry would only add contact pairs to the solver.

     Friction is 0.7 (plastic on a steel shelf), NOT the 4.0 the coloured boxes
     use. Those needed an unphysical value because friction was all that held
     them; this rack is held by a DetachableJoint while carried, so mu here only
     governs whether it slides or tips when it is standing on something - which
     is exactly the behaviour the smooth-transport work needs to be able to
     provoke. -->
<sdf version="1.9">
  <model name="sample_rack">
    <link name="link">

      <inertial>
        <!-- Mass sits low: tray plus filled tubes, with only the light gantry
             above. Inertia is the box approximation over the full
             0.16 x 0.12 x 0.20 envelope, which over-estimates slightly and so
             errs towards a stable, not a twitchy, payload. -->
        <pose>0 0 0.06 0 0 0</pose>
        <mass>0.30</mass>
        <inertia>
          <ixx>1.36e-3</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.64e-3</iyy><iyz>0</iyz>
          <izz>1.00e-3</izz>
        </inertia>
      </inertial>

      <!-- tray -->
      <collision name="tray_collision">
        <pose>0 0 0.0125 0 0 0</pose>
        <geometry><box><size>0.16 0.12 0.025</size></box></geometry>
        <surface>
          <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          <contact><ode><kp>1e6</kp><kd>1.0</kd></ode></contact>
        </surface>
      </collision>
      <visual name="tray_visual">
        <pose>0 0 0.0125 0 0 0</pose>
        <geometry><box><size>0.16 0.12 0.025</size></box></geometry>
        <material>
          <ambient>0.10 0.12 0.16 1</ambient>
          <diffuse>0.16 0.19 0.24 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- six tubes, 3 along x by 2 along y (visual only) -->
      <visual name="tube_0"><pose>-0.03  0.03 0.060 0 0 0</pose>
        <geometry><cylinder><radius>0.0065</radius><length>0.070</length></cylinder></geometry>
        <material><ambient>0.35 0.02 0.04 1</ambient><diffuse>0.55 0.04 0.07 1</diffuse></material></visual>
      <visual name="tube_1"><pose> 0.00  0.03 0.060 0 0 0</pose>
        <geometry><cylinder><radius>0.0065</radius><length>0.070</length></cylinder></geometry>
        <material><ambient>0.35 0.02 0.04 1</ambient><diffuse>0.55 0.04 0.07 1</diffuse></material></visual>
      <visual name="tube_2"><pose> 0.03  0.03 0.060 0 0 0</pose>
        <geometry><cylinder><radius>0.0065</radius><length>0.070</length></cylinder></geometry>
        <material><ambient>0.35 0.02 0.04 1</ambient><diffuse>0.55 0.04 0.07 1</diffuse></material></visual>
      <visual name="tube_3"><pose>-0.03 -0.03 0.060 0 0 0</pose>
        <geometry><cylinder><radius>0.0065</radius><length>0.070</length></cylinder></geometry>
        <material><ambient>0.35 0.02 0.04 1</ambient><diffuse>0.55 0.04 0.07 1</diffuse></material></visual>
      <visual name="tube_4"><pose> 0.00 -0.03 0.060 0 0 0</pose>
        <geometry><cylinder><radius>0.0065</radius><length>0.070</length></cylinder></geometry>
        <material><ambient>0.35 0.02 0.04 1</ambient><diffuse>0.55 0.04 0.07 1</diffuse></material></visual>
      <visual name="tube_5"><pose> 0.03 -0.03 0.060 0 0 0</pose>
        <geometry><cylinder><radius>0.0065</radius><length>0.070</length></cylinder></geometry>
        <material><ambient>0.35 0.02 0.04 1</ambient><diffuse>0.55 0.04 0.07 1</diffuse></material></visual>

      <!-- caps (lavender, i.e. EDTA tubes) -->
      <visual name="cap_0"><pose>-0.03  0.03 0.101 0 0 0</pose>
        <geometry><cylinder><radius>0.0075</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.55 0.45 0.70 1</ambient><diffuse>0.72 0.62 0.88 1</diffuse></material></visual>
      <visual name="cap_1"><pose> 0.00  0.03 0.101 0 0 0</pose>
        <geometry><cylinder><radius>0.0075</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.55 0.45 0.70 1</ambient><diffuse>0.72 0.62 0.88 1</diffuse></material></visual>
      <visual name="cap_2"><pose> 0.03  0.03 0.101 0 0 0</pose>
        <geometry><cylinder><radius>0.0075</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.55 0.45 0.70 1</ambient><diffuse>0.72 0.62 0.88 1</diffuse></material></visual>
      <visual name="cap_3"><pose>-0.03 -0.03 0.101 0 0 0</pose>
        <geometry><cylinder><radius>0.0075</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.55 0.45 0.70 1</ambient><diffuse>0.72 0.62 0.88 1</diffuse></material></visual>
      <visual name="cap_4"><pose> 0.00 -0.03 0.101 0 0 0</pose>
        <geometry><cylinder><radius>0.0075</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.55 0.45 0.70 1</ambient><diffuse>0.72 0.62 0.88 1</diffuse></material></visual>
      <visual name="cap_5"><pose> 0.03 -0.03 0.101 0 0 0</pose>
        <geometry><cylinder><radius>0.0075</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.55 0.45 0.70 1</ambient><diffuse>0.72 0.62 0.88 1</diffuse></material></visual>

      <!-- gantry: two posts either side of the tubes, plus a crossbar -->
      <collision name="post_left_collision">
        <pose>-0.055 0 0.075 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.10</size></box></geometry>
      </collision>
      <visual name="post_left_visual">
        <pose>-0.055 0 0.075 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.10</size></box></geometry>
        <material><ambient>0.20 0.22 0.26 1</ambient><diffuse>0.30 0.33 0.38 1</diffuse></material>
      </visual>
      <collision name="post_right_collision">
        <pose>0.055 0 0.075 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.10</size></box></geometry>
      </collision>
      <visual name="post_right_visual">
        <pose>0.055 0 0.075 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.10</size></box></geometry>
        <material><ambient>0.20 0.22 0.26 1</ambient><diffuse>0.30 0.33 0.38 1</diffuse></material>
      </visual>
      <collision name="crossbar_collision">
        <pose>0 0 0.1325 0 0 0</pose>
        <geometry><box><size>0.13 0.02 0.015</size></box></geometry>
      </collision>
      <visual name="crossbar_visual">
        <pose>0 0 0.1325 0 0 0</pose>
        <geometry><box><size>0.13 0.02 0.015</size></box></geometry>
        <material><ambient>0.20 0.22 0.26 1</ambient><diffuse>0.30 0.33 0.38 1</diffuse></material>
      </visual>

      <!-- grip block: what the Franka Hand actually closes on -->
      <collision name="grip_collision">
        <pose>0 0 0.170 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
        <surface>
          <friction><ode><mu>4.0</mu><mu2>4.0</mu2></ode></friction>
          <contact><ode><kp>1e6</kp><kd>1.0</kd></ode></contact>
        </surface>
      </collision>
      <visual name="grip_visual">
        <pose>0 0 0.170 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
        <material>
          <ambient>0.90 0.05 0.05 1</ambient>
          <diffuse>0.90 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

    </link>
  </model>
</sdf>
