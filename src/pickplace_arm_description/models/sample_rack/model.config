<?xml version="1.0"?>
<!-- Present so the rack can also be pulled in by model://sample_rack, not only
     spawned by file path the way the mission launch does it. -->
<model>
  <name>sample_rack</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Blood sample rack: six capped tubes in a carrier with a 0.06 m red grip
    block sized to the Franka Hand. Payload of the lab to ward transport run.
  </description>
</model>
