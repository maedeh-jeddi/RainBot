<?xml version="1.0"?>
<!-- Required for model://pedestrian to resolve. Without it gz reports
     "Could not find model.config or manifest.xml" and skips the include
     entirely - the model never appears, so its VelocityControl plugin never
     loads and the pedestrian silently stands still no matter what is published
     at its cmd_vel topic. -->
<model>
  <name>pedestrian</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Walking person as a driveable obstacle: OpenRobotics' Fuel mesh and
    inertial, plus VelocityControl so it can be walked along a corridor, and
    PosePublisher so a patrol node can hold it in its lane.
  </description>
</model>
