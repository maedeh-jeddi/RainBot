<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ros2_control system for Gazebo Harmonic.

       This is the ONLY ros2_control system in the description. The Husky A200
       is included with use_platform_controllers:=false and is_sim:=false so
       Clearpath contributes no ros2_control block and no ign_ros2_control
       plugin, and the FR3 is included with ros2_control:=false and
       gazebo:=false for the same reason. Everything is driven from here. -->
  <ros2_control name="pickplace_arm_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- FR3 arm. initial_value spawns the arm in Franka's own "ready" pose
         (joint2 -pi/4, joint4 -3pi/4, joint6 pi/2, joint7 pi/4): elbow bent,
         well clear of the shoulder singularity and of the Husky's top plate.

         This REPLACES the old gripper-down "claw ready" spawn pose, whose
         joint values were derived for the 6-DOF placeholder arm on the old
         0.08 m-tall chassis and are meaningless for a 7-DOF FR3 mounted
         0.384 m up. The mission-side HOME_CONFIG still needs re-deriving
         against this arm (see pick_and_place.py). -->
    <joint name="fr3_joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-0.7854</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint4">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-2.3562</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint5">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint6">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_joint7">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.7854</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Franka Hand. Only finger_joint1 is commanded; finger_joint2 carries a
         <mimic> tag in franka_description's URDF and is reproduced here with
         gz_ros2_control's own mimic parameters (it reads `mimic`/`multiplier`
         from these <param> tags, NOT from the URDF <mimic> element - see
         gz_system.cpp). It must still be declared in this block, or the
         plugin throws "Mimicked joint not found"; but it must NOT be listed
         in any controller's joint list, or two controllers fight over it. -->
    <joint name="fr3_finger_joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.04</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr3_finger_joint2">
      <param name="mimic">fr3_finger_joint1</param>
      <param name="multiplier">1.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.04</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Husky A200 wheels. The A200 macro names its wheel joints exactly the
         same as the old placeholder base did, so diff_drive_controller's
         joint lists carry over unchanged (its wheel_separation/wheel_radius
         do NOT - see config/arm_controllers.yaml). -->
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo Harmonic gz_ros2_control plugin -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find pickplace_arm_description)/config/arm_controllers.yaml</parameters>
      <ros>
        <!-- Emitted only when robot_ns is set. An empty <namespace/> is NOT the
             same as no namespace to the plugin, so the single-robot SDF has to
             come out with this element absent, exactly as before. -->
        <xacro:if value="${robot_ns != ''}">
          <namespace>${robot_ns}</namespace>
        </xacro:if>
        <remapping>~/robot_description:=${ns_topic}/robot_description</remapping>
      </ros>
    </plugin>
  </gazebo>

  <!-- Rigid grasp: weld the box to the gripper instead of relying on friction.
       Friction alone was never reliable. The box slipped out mid-carry on
       EVERY run of the Tugbot-warehouse mission (and intermittently before
       that, which is what the raised mu values below were chasing). A
       DetachableJoint per box gives a hard constraint that cannot slip
       regardless of physics load, carry speed or how off-centre the grip is.

       The gripper still physically closes on the box and the grasp is still
       VERIFIED by the finger gap before anything attaches (see grab_below),
       so this makes a confirmed grasp hold; it does not fake one.

       parent_link is fr3_link7, NOT fr3_hand, for the same reason it used to
       be link6 rather than gripper_base: Gazebo's URDF importer MERGES links
       joined by fixed joints into their parent, so fr3_hand (fixed to
       fr3_link8, itself fixed to fr3_link7) does not survive into the spawned
       SDF and naming it here fails the plugin outright ("Link with name
       [fr3_hand] not found in model [pickplace_arm]. Failed to initialize."),
       silently leaving the box on friction. fr3_link7 is the nearest ancestor
       reached through a non-fixed joint (fr3_joint7), so it is the rigid body
       fr3_hand was merged INTO. To confirm against a live sim, run
       `gz model -m pickplace_arm` and read the link list.

       Each box IS welded the moment it spawns, with no attach requested:
       the plugin creates its joint as soon as the child model appears.
       That makes the startup detach in PickAndPlace.__init__ load-bearing,
       NOT a nicety: without it the robot tows all three boxes off the table
       the moment it drives to the pick. -->
  <xacro:macro name="grasp_attach" params="model">
    <gazebo>
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>fr3_link7</parent_link>
        <child_model>${model}</child_model>
        <child_link>link</child_link>
        <attach_topic>${ns_topic}/${model}/attach</attach_topic>
        <detach_topic>${ns_topic}/${model}/detach</detach_topic>
        <output_topic>${ns_topic}/${model}/attach_state</output_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
    </gazebo>
  </xacro:macro>
  <!-- The coloured boxes of the warehouse run. -->
  <xacro:grasp_attach model="box_red"/>
  <xacro:grasp_attach model="box_green"/>
  <xacro:grasp_attach model="box_blue"/>
  <!-- The sample racks of the hospital run. Declared unconditionally, exactly
       like the boxes: suppress_child_warning is what makes a plugin whose child
       model does not exist in this world harmless, so one robot description
       serves both missions rather than needing a world-dependent URDF. -->
  <xacro:grasp_attach model="rack_red"/>
  <xacro:grasp_attach model="rack_green"/>
  <xacro:grasp_attach model="rack_blue"/>

  <!-- High friction + soft contact on the finger pads so the gripper can
       actually hold a box by friction in Gazebo Harmonic. Raised 3.5 -> 5.0
       (and the box models' own mu 2.0 -> 4.0) after the box intermittently
       slipped out of a good grasp during the lift/carry in the heavier Ionic
       world: under higher physics load the friction hold was marginal, so the
       box occasionally pivoted free mid-carry. The box's mu was the lower
       (limiting) of the two contacting surfaces, so both were raised.
       (franka_description sets its own mu=1.13 on these links, but only when
       built with gazebo:=true, which this description does not do.) -->
  <gazebo reference="fr3_leftfinger">
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.0</maxVel>
  </gazebo>
  <gazebo reference="fr3_rightfinger">
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.0</maxVel>
  </gazebo>

  <!-- Wheel ground contact friction, enough traction to drive/skid-steer
       without excessive slip. Link names come from the A200 macro. -->
  <xacro:macro name="wheel_friction" params="link">
    <gazebo reference="${link}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>1.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_friction link="front_left_wheel"/>
  <xacro:wheel_friction link="front_right_wheel"/>
  <xacro:wheel_friction link="rear_left_wheel"/>
  <xacro:wheel_friction link="rear_right_wheel"/>

  <!-- Wrist RGB-D camera sensor (Gazebo Harmonic). camera_link is fixed to
       fr3_hand but survives the URDF->SDF fixed-joint merge because it
       carries a sensor. -->
  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <topic>${ns_topic}/camera</topic>
      <!-- 5 Hz, down from 30. RGB-D rendering is BY FAR the most expensive
           thing in this simulation: two 640x480 rgbd_camera sensors at 30 Hz
           held the real-time factor at 0.28 with the Gazebo GUI up (measured
           on gazebo.launch.py alone, so this is the simulator itself, not the
           ROS stack). Cutting both to what the code actually consumes took it
           to 0.80, and the full mission stack with RViz and the GUI now runs
           at RTF 1.000 - i.e. real time instead of roughly a quarter of it.
           A 3-box run went from ~555 s of wall clock to ~355 s.

           5 Hz is generous for THIS camera. The wrist camera is only read by
           detect_box_pose(), whose default timeout is 5.0 s, and the
           pick-and-place mission never uses that path at all - it picks with
           the front camera via grab_below(). So this sensor was rendering 30
           frames a second for nothing. -->
      <update_rate>5</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>5.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <!-- camera_link, NOT camera_optical_link. Gazebo Harmonic's rgbd_camera
           emits its PointCloud2 in the GZ BODY convention (X forward, Y left,
           Z up), not the ROS optical one (Z forward, X right, Y down). Tagging
           it with the optical frame was therefore a lie about the data, and
           RViz - which, unlike the mission code, actually honours the header
           frame - applied the optical->body rotation and drew the whole cloud
           swung 90 deg out to the robot's side.

           Measured off a live frame to settle which convention it really is:
               x  +0.26 .. +7.21   (all positive: this is the depth axis)
               y  -5.06 .. +5.60   (left/right)
               z  -0.24 .. +4.28   (floor, 0.22 below the lens, up to ceiling)
           i.e. unambiguously X-forward. See the front camera below for the
           same fix and the reason nothing else changes. -->
      <gz_frame_id>${ns_frame}camera_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- 2D LIDAR sensor (Gazebo Harmonic gpu_lidar) for SLAM + Nav2 -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>${ns_topic}/scan</topic>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <!-- 270 deg forward arc (-135..+135 deg); the excluded 90 deg
               wedge points straight back at the arm, so the scan never hits
               it. With the FR3 at x=0.0799 and this sensor at x=0.4449 the
               arm subtends only ~+/-21 deg about the 180 deg bearing, well
               inside the wedge. 270 samples keeps the same ~1 deg/sample
               resolution as a 360-sample full circle. -->
          <horizontal>
            <samples>270</samples>
            <resolution>1</resolution>
            <min_angle>-2.35619449</min_angle>
            <max_angle>2.35619449</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <!-- 25 m, NOT 8. THE OLD 8 WAS SHORTER THAN THE BUILDING.

               Fine in the warehouse, which is small. In the AWS hospital the
               north-south corridor is a 40.8 m straight run of parallel wall
               (measured off this package's own map, y -25.95 to 14.85 along
               x = 4.5). A sensor that reaches 8 m into it sees two walls and
               nothing else, and sees exactly the SAME two walls from anywhere
               in the middle 25 m of it - so the scan carries no information at
               all about position ALONG the corridor, which is the one axis that
               matters there.

               That breaks localisation in a way no amount of filter tuning can
               reach: alpha1-4, recovery_alpha_* and the z_hit/z_rand pairing
               were each tried and each failed, because all three are downstream
               of information the sensor never delivered. Measured on a failing
               run, with odometry perfectly healthy (d_odom 4.299 against
               d_truth 4.296 - the wheels were NOT slipping): the robot
               travelled 4.3 m down that corridor while AMCL's belief advanced
               0.33 m, ending 4.6 m behind the truth.

               25 m puts both ends of that corridor in view from most of its
               length, which is precisely the measurement that pins position
               along the axis. It is also a real device spec rather than an
               invented one - a SICK TiM781 reaches 25 m where the TiM551 this
               was modelled on reaches 10 - so the sensor stays plausible.

               AMCL's OWN laser_max_range MUST BE RAISED TO MATCH, or it
               discards exactly the beams this exists to provide. Done in
               amcl_hospital.yaml; amcl_tugbot.yaml deliberately stays at 8,
               because the warehouse never had this problem and its numbers are
               the ones that were tuned there. -->
          <max>25.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <gz_frame_id>${ns_frame}lidar_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- IMU sensor: publishes orientation + angular velocity, fused with wheel
       odometry by the robot_localization EKF to keep heading accurate. -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>${ns_topic}/imu</topic>
      <update_rate>50</update_rate>
      <always_on>1</always_on>
      <gz_frame_id>${ns_frame}imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- Front RGB-D camera: detects the box ahead while the base drives. -->
  <gazebo reference="front_camera_link">
    <sensor name="front_rgbd_camera" type="rgbd_camera">
      <topic>${ns_topic}/front_camera</topic>
      <!-- 15 Hz, down from 30 - see the wrist camera above for the measured
           cost. This one carries the whole mission (box pick AND column
           placement), so it keeps roughly 2x the margin it needs rather than
           being cut to the bone: the tightest consumer is approach_column's
           servo loop, which calls detect_box_front(timeout_sec=0.25) and then
           publishes for 4 x 0.03 s, so it cannot go round faster than about
           8 Hz. At 15 Hz a fresh frame is always waiting for it.

           Verified, not assumed: a full 3-box run at these rates placed and
           verified all three boxes with ZERO "lost the column", "no box
           detected" or "jaws closed on air" warnings. -->
      <!-- 10 Hz, down from 15. THREE OF THESE SHARE ONE BRIDGE PROCESS, and
           that process is single threaded. The servo loop still cannot go round
           faster than about 8 Hz (see above), so 10 keeps a fresh frame waiting
           for it while cutting a third of the traffic. -->
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <camera>
        <!-- Wide 90 deg FOV so the box stays in view even when Nav2 leaves the
             base a little off-heading, so the front-cam approach never has to
             rotate the chassis to re-acquire it (no spin before arriving). -->
        <horizontal_fov>1.57</horizontal_fov>
        <image>
          <!-- SQUARE, 480x480, NOT 640x480. The horizontal FOV is set to 90 deg
               above, and the VERTICAL field follows from the aspect ratio: at
               4:3 that is only 73.7 deg, i.e. 36.85 deg above the lens axis.
               That is enough for a box and not enough for a rack.

               Measured directly, walking the base in on a rack and counting
               coloured pixels in the detection gate:

                   base -> rack   0.862   2665 px
                                  0.792   1360 px   (blob half out of frame)
                                  0.727      0 px   (gone)

               The rack's grip block sits 0.271 m above the lens, so at 0.727 m
               it subtends 41.9 deg - outside the 36.85 deg the sensor had. A
               box on the same table sits 0.107 m up and subtends 18 deg, which
               is why every box pick worked and the rack pick failed at exactly
               the tuned CLAW_STOP_X of 0.75.

               A square image makes the vertical field equal to the horizontal
               90 deg, giving 45 deg of half-angle and 5 deg of margin at the
               stop distance - so CLAW_STOP_X and every distance tuned against
               it stay exactly as they were. 480x480 also carries 25% FEWER
               points than 640x480, which the fleet's three cameras care about.

               The blob shrinks with the wider field (measured 2665 px scales to
               roughly 1600), still fifty times MIN_VALID_PIXELS. -->
          <!-- 320x320, down from 480x480, AND STILL SQUARE. The square
               aspect is what buys the 90 deg VERTICAL field the racks need
               (see above); the PIXEL COUNT is not what buys it, so this
               costs nothing in field of view. What it buys back is bandwidth:
               an organised cloud is ~32 bytes a point, so 480x480 at 15 Hz is
               about 110 MB/s PER ROBOT and three of those share one
               single-threaded ros_gz bridge. Together with the rate change
               above this is a ~70% cut.
          
               Detection is unaffected: the gate needs 30 coloured pixels and
               the 0.06 m grip block still spans ~15 px (~230 px area) at the
               0.8 m stand-off. -->
          <width>320</width>
          <height>320</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <!-- front_camera_link, NOT front_camera_optical_link - same correction
           as the wrist camera above, and the reason the cloud used to render
           off to the robot's side in RViz instead of ahead of it.

           This changes NOTHING for the mission: PickAndPlace._detect never
           reads the header frame, it hardcodes cloud_frame='front_camera_link'
           and transforms from there, which is exactly the frame the data was
           always really in - which is also why detection stayed accurate (the
           column near-face reads to 3 mm) the whole time the header was wrong.
           The gates' documented "camera frame (X-forward, Y-left, Z-up)" is
           now literally what the header says too.

           front_camera_optical_link is left in the URDF: it costs one static
           transform, it is the correct ROS optical frame should anything ever
           need one (depth_image_proc and friends assume that convention), and
           removing it would break nothing but document nothing either. -->
      <gz_frame_id>${ns_frame}front_camera_link</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
