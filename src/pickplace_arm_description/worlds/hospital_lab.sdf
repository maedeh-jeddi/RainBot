<?xml version='1.0' encoding='ASCII'?>
<!-- Hospital world for the blood-sample transport mission: a LAB at the west
     end, a 3 m corridor, and a destination WARD at the east end.

     Layout (metres, world frame; walls are 0.15 thick and 2.5 tall):

         y
         4 +==============+                       +==============+
           |     LAB      |                       |     WARD     |
       1.5 |              +===========+===========+              |
           |            door        CORRIDOR    door             |
      -1.5 |              +===========+===========+              |
           |              |                       |              |
        -4 +==============+                       +==============+
          -9             -1                       9              17   x

     Doorways are 1.6 m wide (y in [-0.8, 0.8]) at x = -1 and x = 9. The
     corridor is 3.0 m wide, which leaves at least 1.7 m of clear width past
     every obstacle placed in it - the Husky is 0.67 m wide, so Nav2 always
     has room to pass something rather than stop dead in front of it, which is
     the whole point of this world.

     The robot spawns in the lab at (-6.5, 0). gazebo.launch.py reads SPAWN_X /
     SPAWN_Y, so launch it as:
         WORLD=hospital_lab.sdf SPAWN_X=-6.5 SPAWN_Y=0.0 ros2 launch ...

     PROP PLACEMENT is not eyeballed: every Fuel model's footprint was measured
     from its own mesh (min/max of the OBJ vertices times the model's <scale>)
     and the poses below are chosen so no two footprints overlap and nothing
     encroaches on the driving lane. All these models put their origin on the
     floor, so they all spawn at z = 0.

     PEOPLE. The two `Walking person` includes are ordinary models with mesh
     collision and an 80 kg inertial - NOT SDF <actor>s. That matters: actors
     in gz-sim carry no collision geometry at all, so an actor is invisible to
     contact physics and cannot be an obstacle Nav2 must genuinely avoid. These
     are pinned <static> here so they stand still and stable; dropping the
     <static> tag and driving them with a velocity/trajectory system is how they
     become MOVING pedestrians, and the collision geometry is already there for
     when they do. The seated and standing hospital staff (Nurse, Scrubs,
     visitors, patients) are static mesh models and are real obstacles too.

     The Fuel models this world pulls in are vendored under fuel_cache/, so it
     loads with no network access (see CMakeLists.txt and gazebo.launch.py). -->
<sdf version='1.7'>
  <world name='hospital_lab'>
    <gravity>0 0 -9.8</gravity>
    <physics type='ode'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <max_contacts>10</max_contacts>
    </physics>
    <plugin name='ignition::gazebo::systems::Physics' filename='libignition-gazebo-physics-system.so'/>
    <plugin name='ignition::gazebo::systems::UserCommands' filename='libignition-gazebo-user-commands-system.so'/>
    <plugin name='ignition::gazebo::systems::SceneBroadcaster' filename='libignition-gazebo-scene-broadcaster-system.so'/>
    <plugin name='ignition::gazebo::systems::Imu' filename='ignition-gazebo-imu-system'/>
    <plugin name='ignition::gazebo::systems::Sensors' filename='ignition-gazebo-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="0">
      <plugin filename="GzScene3D" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <!-- Looks down the corridor from above the lab. -->
        <camera_pose>-12.0 -9.0 12.0 0 0.62 0.72</camera_pose>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="ComponentInspector" name="Component inspector">
        <ignition-gui>
          <property key="width" type="double">400</property>
          <property key="height" type="double">375</property>
          <property key="state" type="string">docked_collapsed</property>
        </ignition-gui>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <ignition-gui>
          <property key="width" type="double">400</property>
          <property key="height" type="double">375</property>
          <property key="state" type="string">docked_collapsed</property>
        </ignition-gui>
      </plugin>
    </gui>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>0</cast_shadows>
      <pose>-5 -3 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>1 1 1 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- Collision ground. The visible floor is the slab below; this plane is
         what the wheels actually rest on, matching tugbot_warehouse.sdf. -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane><normal>0.0 0.0 1</normal><size>1 1</size></plane>
          </geometry>
        </collision>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- Visible floor slab, 0.5 m proud of the walls on every side. -->
    <model name='floor'>
      <static>true</static>
      <pose>4.0 0 -0.01 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry><box><size>27.0 9.0 0.02</size></box></geometry>
          <material>
            <ambient>0.62 0.66 0.68 1</ambient>
            <diffuse>0.74 0.78 0.80 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================== -->
    <!-- Walls                                                               -->
    <!-- ================================================================== -->
    <!-- Each is a static box; centre pose then size. The two "door" walls are
         split into a north and a south segment either side of the 1.6 m
         opening. Height 2.5 m, so the LIDAR's 0.447 m scan plane always cuts
         solid wall and SLAM sees a closed building. -->

    <model name='wall_lab_west'>
      <static>true</static><pose>-9.0 0 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.15 8.15 2.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.15 8.15 2.5</size></box></geometry>
          <material><ambient>0.72 0.75 0.76 1</ambient><diffuse>0.86 0.89 0.90 1</diffuse></material></visual>
      </link>
    </model>
    <model name='wall_lab_north'>
      <static>true</static><pose>-5.0 4.0 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>8.15 0.15 2.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>8.15 0.15 2.5</size></box></geometry>
          <material><ambient>0.72 0.75 0.76 1</ambient><diffuse>0.86 0.89 0.90 1</diffuse></material></visual>
      </link>
    </model>
    <model name='wall_lab_south'>
      <static>true</static><pose>-5.0 -4.0 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>8.15 0.15 2.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>8.15 0.15 2.5</size></box></geometry>
          <material><ambient>0.72 0.75 0.76 1</ambient><diffuse>0.86 0.89 0.90 1</diffuse></material></visual>
      </link>
    </model>
    <model name='wall_lab_east_north'>
      <static>true</static><pose>-1.0 2.5 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.15 3.0 2.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.15 3.0 2.5</size></box></geometry>
          <material><ambient>0.72 0.75 0.76 1</ambient><diffuse>0.86 0.89 0.90 1</diffuse></material></visual>
      </link>
    </model>
    <model name='wall_lab_east_south'>
      <static>true</static><pose>-1.0 -2.5 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.15 3.0 2.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.15 3.0 2.5</size></box></geometry>
          <material><ambient>0.72 0.75 0.76 1</ambient><diffuse>0.86 0.89 0.90 1</diffuse></material></visual>
      </link>
    </model>

    <model name='wall_corridor_north'>
      <static>true</static><pose>4.0 2.0 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>10.0 0.15 2.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>10.0 0.15 2.5</size></box></geometry>
          <material><ambient>0.70 0.74 0.72 1</ambient><diffuse>0.84 0.88 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name='wall_corridor_south'>
      <static>true</static><pose>4.0 -2.0 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>10.0 0.15 2.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>10.0 0.15 2.5</size></box></geometry>
          <material><ambient>0.70 0.74 0.72 1</ambient><diffuse>0.84 0.88 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <model name='wall_ward_east'>
      <static>true</static><pose>17.0 0 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.15 8.15 2.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.15 8.15 2.5</size></box></geometry>
          <material><ambient>0.72 0.75 0.76 1</ambient><diffuse>0.86 0.89 0.90 1</diffuse></material></visual>
      </link>
    </model>
    <model name='wall_ward_north'>
      <static>true</static><pose>13.0 4.0 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>8.15 0.15 2.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>8.15 0.15 2.5</size></box></geometry>
          <material><ambient>0.72 0.75 0.76 1</ambient><diffuse>0.86 0.89 0.90 1</diffuse></material></visual>
      </link>
    </model>
    <model name='wall_ward_south'>
      <static>true</static><pose>13.0 -4.0 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>8.15 0.15 2.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>8.15 0.15 2.5</size></box></geometry>
          <material><ambient>0.72 0.75 0.76 1</ambient><diffuse>0.86 0.89 0.90 1</diffuse></material></visual>
      </link>
    </model>
    <model name='wall_ward_west_north'>
      <static>true</static><pose>9.0 2.5 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.15 3.0 2.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.15 3.0 2.5</size></box></geometry>
          <material><ambient>0.72 0.75 0.76 1</ambient><diffuse>0.86 0.89 0.90 1</diffuse></material></visual>
      </link>
    </model>
    <model name='wall_ward_west_south'>
      <static>true</static><pose>9.0 -2.5 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.15 3.0 2.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.15 3.0 2.5</size></box></geometry>
          <material><ambient>0.72 0.75 0.76 1</ambient><diffuse>0.86 0.89 0.90 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================================================================== -->
    <!-- LAB                                                                 -->
    <!-- ================================================================== -->

    <!-- Collection bench, against the north wall with its transfer shelf
         facing SOUTH (yaw = pi/2 rotates the model's -x shelf face onto -y).
         The shelf slab spans y in [2.72, 3.02] with its top at z = 0.30; the
         sample rack is spawned onto it by the mission launch, not baked in
         here, exactly as the coloured boxes are in the warehouse mission.
         A robot squaring up at (-5.0, 2.1) facing +y puts the FR3's base
         0.69 m from the rack - inside the arm's 0.855 m reach - with its
         bumper 0.12 m short of the shelf edge. -->
    <include>
      <uri>model://lab_bench</uri>
      <name>lab_bench_collect</name>
      <pose>-5.0 3.4 0 0 0 1.5708</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/MainTable</uri>
      <name>lab_worktable</name>
      <pose>-5.5 -3.3 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/MetalCabinet</uri>
      <name>lab_cabinet_0</name>
      <pose>-8.65 2.6 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/MetalCabinet</uri>
      <name>lab_cabinet_1</name>
      <pose>-8.65 1.6 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/StorageRack</uri>
      <name>lab_storage</name>
      <pose>-8.5 -1.5 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/InstrumentCart1</uri>
      <name>lab_instrument_cart</name>
      <pose>-2.0 2.8 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/SurgicalTrolley</uri>
      <name>lab_trolley</name>
      <pose>-2.2 -2.5 0 0 0 0</pose>
    </include>
    <!-- Lab staff: static, with mesh collision, so they are genuine obstacles. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Nurse</uri>
      <name>lab_technician</name>
      <pose>-4.0 2.0 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Scrubs</uri>
      <name>lab_scrubs</name>
      <pose>-7.5 2.5 0 0 0 0</pose>
    </include>

    <!-- ================================================================== -->
    <!-- CORRIDOR                                                            -->
    <!-- ================================================================== -->
    <!-- Everything here is placed against a wall. The tightest gap is past
         the parking trolley: it reaches y = -0.75, leaving 2.18 m of clear
         width. Nothing in the corridor is shorter than the LIDAR's 0.447 m
         scan plane except the handrails, which are flush with the wall. -->

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/SmallTrolley</uri>
      <name>corridor_trolley</name>
      <pose>0.3 -1.60 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/IVStand</uri>
      <name>corridor_ivstand</name>
      <pose>2.2 1.70 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/ParkingTrolleyMin</uri>
      <name>corridor_parking_trolley</name>
      <pose>5.0 -1.55 0 0 0 0</pose>
    </include>
    <!-- Handrails sit at 0.95 m, i.e. above the scan plane and flush with the
         wall, so they are scenery rather than obstacles. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Handrail</uri>
      <name>corridor_handrail_0</name>
      <pose>1.5 1.89 0.95 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Handrail</uri>
      <name>corridor_handrail_1</name>
      <pose>5.5 1.89 0.95 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/ExitSign</uri>
      <name>corridor_exit_sign</name>
      <pose>8.7 1.90 2.05 0 0 0</pose>
    </include>

    <!-- NO PEDESTRIANS HERE, DELIBERATELY. They walk, so they are spawned at
         mission time (see mission_hospital.launch.py and models/pedestrian)
         rather than being part of the scene the map is built from. Anything
         standing here when hospital_map_drive runs is baked into
         maps/hospital_lab as permanent wall; a moving obstacle recorded that
         way makes the robot dodge the empty space where the person used to be
         while the live one goes unnoticed. The first version of this world DID
         park two of them in the corridor, and the mission promptly wedged the
         base against one. Dynamic obstacles belong to the LIDAR-fed obstacle
         layer, so the static map must never contain them.

         The corridor is 4.0 m wide and the doorways 2.0 m for the same reason:
         it has to hold a 0.99 x 0.67 m robot passing a walking person, not just
         the robot. At 3.0 m with someone standing mid-lane there was 1.47 m
         left, which Nav2 could not thread. -->

    <!-- ================================================================== -->
    <!-- WARD                                                                -->
    <!-- ================================================================== -->

    <!-- Delivery bench, shelf facing WEST towards the ward door, so a robot
         arriving along the corridor squares up on it without turning around. -->
    <include>
      <uri>model://lab_bench</uri>
      <name>lab_bench_deliver</name>
      <pose>14.5 0.0 0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/NurseDesk</uri>
      <name>ward_nurse_desk</name>
      <pose>13.0 3.0 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/ElderMalePatient</uri>
      <name>ward_bed_0</name>
      <pose>11.5 -2.9 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/TrolleyBed</uri>
      <name>ward_bed_1</name>
      <pose>14.8 -2.9 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/BedsideTable</uri>
      <name>ward_bedside_table</name>
      <pose>12.9 -2.2 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/BloodPressureMonitor</uri>
      <name>ward_bp_monitor</name>
      <pose>16.5 1.2 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/PatientWheelChair</uri>
      <name>ward_wheelchair</name>
      <pose>10.2 1.3 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/VisitorChair</uri>
      <name>ward_chair</name>
      <pose>16.4 -1.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/MiniSofa</uri>
      <name>ward_sofa</name>
      <pose>16.4 2.3 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/GarbagePileV1</uri>
      <name>ward_garbage</name>
      <pose>16.35 -3.3 0 0 0 0</pose>
    </include>
    <!-- Seated visitors, each ON A CHAIR. The chair is not decoration: these
         Fuel models are built to be co-located with one, and without it the
         figure sits on nothing. Measured from the meshes themselves rather than
         guessed - VisitorChair's seat surface is a dense band of vertices at
         z = 0.35..0.40, and both seated figures put their hips at z = 0.38..0.43
         with their feet on the floor - so chair and visitor share a pose
         exactly, and the person lands on the seat. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/VisitorChair</uri>
      <name>ward_visitor_0_chair</name>
      <pose>16.4 -2.6 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/FemaleVisitorSit</uri>
      <name>ward_visitor_0</name>
      <pose>16.4 -2.6 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/VisitorChair</uri>
      <name>ward_visitor_1_chair</name>
      <pose>16.4 0.0 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/MaleVisitorSit</uri>
      <name>ward_visitor_1</name>
      <pose>16.4 0.0 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Nurse</uri>
      <name>ward_nurse</name>
      <pose>10.0 -1.2 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Scrubs</uri>
      <name>ward_scrubs</name>
      <pose>12.5 1.5 0 0 0 0</pose>
    </include>

  </world>
</sdf>
