    <actor name="walker_visitor">
      <skin><filename>https://fuel.gazebosim.org/1.0/luca/models/visitorkidwalk/1/files/meshes/VisitorKidWalk.dae</filename><scale>1.0</scale></skin>
      <animation name="walk"><filename>https://fuel.gazebosim.org/1.0/luca/models/visitorkidwalk/1/files/meshes/VisitorKidWalk.dae</filename><scale>1.0</scale>
        <interpolate_x>true</interpolate_x></animation>
      <script><loop>true</loop><auto_start>true</auto_start>
