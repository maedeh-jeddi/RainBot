        <interpolate_x>true</interpolate_x></animation>
      <script><loop>true</loop><auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0.00</time><pose>3.830 -8.000 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>3.64</time><pose>3.830 -6.000 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>3.97</time><pose>3.830 -6.000 0 0 0 2.6180</pose></waypoint>
          <waypoint><time>4.30</time><pose>3.830 -6.000 0 0 0 3.6652</pose></waypoint>
          <waypoint><time>4.64</time><pose>3.830 -6.000 0 0 0 4.7124</pose></waypoint>
          <waypoint><time>8.27</time><pose>3.830 -8.000 0 0 0 4.7124</pose></waypoint>
          <waypoint><time>8.61</time><pose>3.830 -8.000 0 0 0 5.7596</pose></waypoint>
          <waypoint><time>8.94</time><pose>3.830 -8.000 0 0 0 6.8068</pose></waypoint>
          <waypoint><time>9.27</time><pose>3.830 -8.000 0 0 0 7.8540</pose></waypoint>
        </trajectory>
