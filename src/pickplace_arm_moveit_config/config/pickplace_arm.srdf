<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined

    Robot: Clearpath Husky A200 base + Franka FR3 (7 DOF) + Franka Hand.

    The FR3 and Franka Hand collision pairs below are taken verbatim (with the
    `fr3_` prefix applied) from franka_description's own SRDF macros -
    robots/common/franka_arm.srdf.xacro and
    end_effectors/franka_hand/franka_hand.srdf.xacro - rather than being
    re-derived, so the arm's self-collision matrix is the vendor's proven one.
    The Husky pairs and the arm-to-base pairs are ours.
-->
<robot name="pickplace_arm">
    <!--GROUPS: Representation of a set of joints and links. This can be useful for specifying DOF to plan for, defining arms, end effectors, etc-->
    <!--LINKS: When a link is specified, the parent joint of that link (if it exists) is automatically included-->
    <!--JOINTS: When a joint is specified, the child link of that joint (which will always exist) is automatically included-->
    <!--CHAINS: When a chain is specified, all the links along the chain (including endpoints) are included in the group. Additionally, all the joints that are parents to included links are also included. This means that joints along the chain and the parent joint of the base link are included in the group-->
    <!--SUBGROUPS: Groups can also be formed by referencing to already defined group names-->

    <!-- Group names stay `arm` and `gripper` (not franka's `fr3_arm`/`fr3_hand`)
         so pymoveit2 callers in pickplace_arm_bringup keep working. -->
    <group name="arm">
        <chain base_link="fr3_link0" tip_link="fr3_hand_tcp"/>
    </group>
    <group name="gripper">
        <link name="fr3_hand"/>
        <link name="fr3_leftfinger"/>
        <link name="fr3_rightfinger"/>
        <joint name="fr3_finger_joint1"/>
        <!-- finger_joint2 carries a <mimic> of finger_joint1 in the URDF, so
             MoveIt must treat it as passive rather than plan for it. -->
        <passive_joint name="fr3_finger_joint2"/>
    </group>

    <!--GROUP STATES: Purpose: Define a named state for a particular group, in terms of joint values. This is useful to define states like 'folded arms'-->
    <!-- NOTE: the all-zeros "home" state the 6-DOF placeholder arm used is an
         INVALID configuration for an FR3: joint4's range is [-3.077, -0.117]
         and joint6's is [0.440, 4.622], so 0 is outside both. `home` is
         therefore defined as Franka's own `ready` pose. -->
    <group_state name="home" group="arm">
        <joint name="fr3_joint1" value="0"/>
        <joint name="fr3_joint2" value="-0.7854"/>
        <joint name="fr3_joint3" value="0"/>
        <joint name="fr3_joint4" value="-2.3562"/>
        <joint name="fr3_joint5" value="0"/>
        <joint name="fr3_joint6" value="1.5708"/>
        <joint name="fr3_joint7" value="0.7854"/>
    </group_state>
    <group_state name="ready" group="arm">
        <joint name="fr3_joint1" value="0"/>
        <joint name="fr3_joint2" value="-0.7854"/>
        <joint name="fr3_joint3" value="0"/>
        <joint name="fr3_joint4" value="-2.3562"/>
        <joint name="fr3_joint5" value="0"/>
        <joint name="fr3_joint6" value="1.5708"/>
        <joint name="fr3_joint7" value="0.7854"/>
    </group_state>
    <group_state name="extended" group="arm">
        <joint name="fr3_joint1" value="0"/>
        <joint name="fr3_joint2" value="0"/>
        <joint name="fr3_joint3" value="0"/>
        <joint name="fr3_joint4" value="-0.1169"/>
        <joint name="fr3_joint5" value="0"/>
        <joint name="fr3_joint6" value="1.5708"/>
        <joint name="fr3_joint7" value="0.7854"/>
    </group_state>
    <group_state name="open" group="gripper">
        <joint name="fr3_finger_joint1" value="0.035"/>
        <joint name="fr3_finger_joint2" value="0.035"/>
    </group_state>
    <group_state name="closed" group="gripper">
        <joint name="fr3_finger_joint1" value="0"/>
        <joint name="fr3_finger_joint2" value="0"/>
    </group_state>

    <!--END EFFECTOR: Purpose: Represent information about an end effector.-->
    <end_effector name="gripper" parent_link="fr3_hand_tcp" group="gripper" parent_group="arm"/>

    <!--VIRTUAL JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame of reference (considered fixed with respect to the robot)-->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->

    <!-- ===== FR3 arm, from franka_description/robots/common/franka_arm.srdf.xacro ===== -->
    <disable_collisions link1="fr3_link0" link2="fr3_link1" reason="Adjacent"/>
    <disable_collisions link1="fr3_link0" link2="fr3_link2" reason="Never"/>
    <disable_collisions link1="fr3_link0" link2="fr3_link3" reason="Never"/>
    <disable_collisions link1="fr3_link0" link2="fr3_link4" reason="Never"/>
    <disable_collisions link1="fr3_link1" link2="fr3_link2" reason="Adjacent"/>
    <disable_collisions link1="fr3_link1" link2="fr3_link3" reason="Never"/>
    <disable_collisions link1="fr3_link1" link2="fr3_link4" reason="Never"/>
    <disable_collisions link1="fr3_link2" link2="fr3_link3" reason="Adjacent"/>
    <disable_collisions link1="fr3_link2" link2="fr3_link4" reason="Never"/>
    <disable_collisions link1="fr3_link2" link2="fr3_link6" reason="Never"/>
    <disable_collisions link1="fr3_link3" link2="fr3_link4" reason="Adjacent"/>
    <disable_collisions link1="fr3_link3" link2="fr3_link5" reason="Never"/>
    <disable_collisions link1="fr3_link3" link2="fr3_link6" reason="Never"/>
    <disable_collisions link1="fr3_link3" link2="fr3_link7" reason="Never"/>
    <disable_collisions link1="fr3_link4" link2="fr3_link5" reason="Adjacent"/>
    <disable_collisions link1="fr3_link4" link2="fr3_link6" reason="Never"/>
    <disable_collisions link1="fr3_link4" link2="fr3_link7" reason="Never"/>
    <disable_collisions link1="fr3_link4" link2="fr3_link8" reason="Never"/>
    <disable_collisions link1="fr3_link5" link2="fr3_link6" reason="Adjacent"/>
    <disable_collisions link1="fr3_link5" link2="fr3_link7" reason="Never"/>
    <disable_collisions link1="fr3_link6" link2="fr3_link7" reason="Adjacent"/>
    <disable_collisions link1="fr3_link6" link2="fr3_link8" reason="Default"/>
    <disable_collisions link1="fr3_link7" link2="fr3_link8" reason="Adjacent"/>

    <!-- ===== Franka Hand, from franka_description/end_effectors/franka_hand/franka_hand.srdf.xacro ===== -->
    <disable_collisions link1="fr3_hand" link2="fr3_leftfinger" reason="Adjacent"/>
    <disable_collisions link1="fr3_hand" link2="fr3_rightfinger" reason="Adjacent"/>
    <disable_collisions link1="fr3_leftfinger" link2="fr3_rightfinger" reason="Default"/>
    <disable_collisions link1="fr3_hand" link2="fr3_link3" reason="Never"/>
    <disable_collisions link1="fr3_hand" link2="fr3_link4" reason="Never"/>
    <disable_collisions link1="fr3_hand" link2="fr3_link6" reason="Never"/>
    <disable_collisions link1="fr3_hand" link2="fr3_link7" reason="Adjacent"/>
    <disable_collisions link1="fr3_hand" link2="fr3_link8" reason="Adjacent"/>
    <disable_collisions link1="fr3_leftfinger" link2="fr3_link3" reason="Never"/>
    <disable_collisions link1="fr3_leftfinger" link2="fr3_link4" reason="Never"/>
    <disable_collisions link1="fr3_leftfinger" link2="fr3_link6" reason="Never"/>
    <disable_collisions link1="fr3_leftfinger" link2="fr3_link7" reason="Never"/>
    <disable_collisions link1="fr3_leftfinger" link2="fr3_link8" reason="Never"/>
    <disable_collisions link1="fr3_link3" link2="fr3_rightfinger" reason="Never"/>
    <disable_collisions link1="fr3_link4" link2="fr3_rightfinger" reason="Never"/>
    <disable_collisions link1="fr3_link6" link2="fr3_rightfinger" reason="Never"/>
    <disable_collisions link1="fr3_link7" link2="fr3_rightfinger" reason="Never"/>
    <disable_collisions link1="fr3_link8" link2="fr3_rightfinger" reason="Never"/>

    <!-- ===== Wrist RGB-D camera housing, rigidly mounted on fr3_hand ===== -->
    <disable_collisions link1="camera_link" link2="fr3_hand" reason="Adjacent"/>
    <disable_collisions link1="camera_link" link2="fr3_leftfinger" reason="Never"/>
    <disable_collisions link1="camera_link" link2="fr3_rightfinger" reason="Never"/>
    <disable_collisions link1="camera_link" link2="fr3_link8" reason="Never"/>
    <disable_collisions link1="camera_link" link2="fr3_link7" reason="Never"/>
    <disable_collisions link1="camera_link" link2="fr3_link6" reason="Never"/>
    <disable_collisions link1="camera_link" link2="fr3_link5" reason="Never"/>
    <disable_collisions link1="camera_link" link2="fr3_link4" reason="Never"/>
    <disable_collisions link1="camera_link" link2="fr3_link3" reason="Never"/>

    <!-- ===== Arm to Husky =====
         fr3_link0 is bolted flat onto top_plate_link, so those two are
         permanently in contact. link1 pivots 0.333 m above the plate and can
         never reach it or the chassis. link2 and beyond are deliberately NOT
         disabled: the arm genuinely can fold down into the Husky, and MoveIt
         should refuse those configurations. -->
    <disable_collisions link1="fr3_link0" link2="top_plate_link" reason="Adjacent"/>
    <disable_collisions link1="fr3_link0" link2="base_link" reason="Never"/>
    <disable_collisions link1="fr3_link1" link2="top_plate_link" reason="Never"/>
    <disable_collisions link1="fr3_link1" link2="base_link" reason="Never"/>
    <disable_collisions link1="fr3_link0" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="fr3_link1" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="fr3_link0" link2="front_camera_link" reason="Never"/>
    <disable_collisions link1="fr3_link1" link2="front_camera_link" reason="Never"/>
    <disable_collisions link1="fr3_link0" link2="front_left_wheel" reason="Never"/>
    <disable_collisions link1="fr3_link0" link2="front_right_wheel" reason="Never"/>
    <disable_collisions link1="fr3_link0" link2="rear_left_wheel" reason="Never"/>
    <disable_collisions link1="fr3_link0" link2="rear_right_wheel" reason="Never"/>
    <disable_collisions link1="fr3_link1" link2="front_left_wheel" reason="Never"/>
    <disable_collisions link1="fr3_link1" link2="front_right_wheel" reason="Never"/>
    <disable_collisions link1="fr3_link1" link2="rear_left_wheel" reason="Never"/>
    <disable_collisions link1="fr3_link1" link2="rear_right_wheel" reason="Never"/>

    <!-- ===== Husky A200 internal =====
         The wheels overlap the chassis collision box (wheel centres are at
         y=+/-0.2775 with radius 0.1651, the chassis is 0.5709 wide), so those
         pairs are permanently colliding and must be disabled or the robot is
         never out of self-collision. -->
    <disable_collisions link1="base_link" link2="front_left_wheel" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="front_right_wheel" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="rear_left_wheel" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="rear_right_wheel" reason="Adjacent"/>
    <disable_collisions link1="front_left_wheel" link2="front_right_wheel" reason="Never"/>
    <disable_collisions link1="front_left_wheel" link2="rear_left_wheel" reason="Never"/>
    <disable_collisions link1="front_left_wheel" link2="rear_right_wheel" reason="Never"/>
    <disable_collisions link1="front_right_wheel" link2="rear_left_wheel" reason="Never"/>
    <disable_collisions link1="front_right_wheel" link2="rear_right_wheel" reason="Never"/>
    <disable_collisions link1="rear_left_wheel" link2="rear_right_wheel" reason="Never"/>
    <disable_collisions link1="base_link" link2="top_plate_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="front_camera_link" reason="Adjacent"/>
    <disable_collisions link1="top_plate_link" link2="lidar_link" reason="Adjacent"/>
    <disable_collisions link1="top_plate_link" link2="front_camera_link" reason="Never"/>
    <disable_collisions link1="lidar_link" link2="front_camera_link" reason="Never"/>
    <disable_collisions link1="front_left_wheel" link2="top_plate_link" reason="Never"/>
    <disable_collisions link1="front_right_wheel" link2="top_plate_link" reason="Never"/>
    <disable_collisions link1="rear_left_wheel" link2="top_plate_link" reason="Never"/>
    <disable_collisions link1="rear_right_wheel" link2="top_plate_link" reason="Never"/>
    <disable_collisions link1="front_left_wheel" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="front_right_wheel" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="rear_left_wheel" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="rear_right_wheel" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="front_left_wheel" link2="front_camera_link" reason="Never"/>
    <disable_collisions link1="front_right_wheel" link2="front_camera_link" reason="Never"/>
    <disable_collisions link1="rear_left_wheel" link2="front_camera_link" reason="Never"/>
    <disable_collisions link1="rear_right_wheel" link2="front_camera_link" reason="Never"/>
</robot>
